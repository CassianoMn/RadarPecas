# ===================================================
# RadarPeças - Configurações de Ambiente (Exemplo)
# Copie este arquivo para .env na raiz antes de iniciar
# ===================================================

# Configurações do Banco de Dados PostgreSQL / PostGIS
POSTGRES_USER=postgres
POSTGRES_PASSWORD=123456
POSTGRES_DB=radarPecas
POSTGRES_PORT=5432
POSTGRES_HOST=localhost

# String de Conexão padrão para o ASP.NET Core
DATABASE_URL=Host=localhost;Port=5432;Database=radarPecas;Username=postgres;Password=123456

# Configurações de Autenticação JWT
# ATENÇÃO: gere um segredo próprio para produção (mínimo 32 caracteres).
# Exemplo: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=troque-este-segredo-em-producao-com-no-minimo-32-caracteres
JWT_ISSUER=RadarPecasAPI
JWT_AUDIENCE=RadarPecasApp
JWT_EXPIRATION_HOURS=24

# URL da API para o Frontend React
VITE_API_BASE_URL=http://localhost:5150/api
